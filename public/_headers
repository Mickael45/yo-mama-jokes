# Cloudflare Workers static-assets response headers (parsed at the edge, not
# served as an asset). Translated from the retired vercel.json. See MASTER §11/§14.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Content-hashed build output never changes — cache it forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
