---
import "@/styles/globals.css";
import { Font } from "astro:assets";
import Seo from "@/components/Seo.astro";
import InstallPrompt from "@/components/InstallPrompt.astro";
import { organizationSchema, websiteSchema } from "@/lib/jsonld";

interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
}

const { title, description, path, image, noindex, jsonLd } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c0a13" />
    <meta
      name="google-site-verification"
      content="5LWdds1LtKAg7v_mojIG0FRYVWNkL8FIF3Q1f5ZT0n4"
    />
    {/* Bing Webmaster Tools — replace REPLACE_WITH_BING_TOKEN after verifying
        the site at https://www.bing.com/webmasters (gateway to Copilot). */}
    <meta name="msvalidate.01" content="REPLACE_WITH_BING_TOKEN" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Self-hosted fonts (Astro Fonts API). Preload the display font used by
        the above-the-fold h1; the body font loads with a size-matched fallback. */}
    <Font cssVariable="--font-anton" preload />
    <Font cssVariable="--font-outfit" />

    <Seo
      title={title}
      description={description}
      path={path}
      image={image}
      noindex={noindex}
      jsonLd={jsonLd}
    />

    {/* Site-wide structured data: publisher + website identity on every page. */}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify([organizationSchema(), websiteSchema()])}
    />
  </head>

  <body class="antialiased">
    <div class="site-shell flex flex-col min-h-screen">
      <header class="site-header py-4">
        <div
          class="container mx-auto px-4 flex justify-between items-center"
        >
          <a href="/" class="text-lg font-bold site-logo-link">
            <img
              src="/logo.svg"
              alt="Yo Mama Jokes Central"
              class="w-12 h-12 sm:w-[70px] sm:h-[70px]"
              width="70"
              height="70"
            />
          </a>
          <nav class="site-nav space-x-3 sm:space-x-6">
            <a href="/" class="site-nav-link">Home</a>
            <a href="/categories" class="site-nav-link">Categories</a>
            <a href="/about" class="site-nav-link">About</a>
            <a href="/contact" class="site-nav-link">Contact</a>
          </nav>
        </div>
      </header>

      <main class="site-main mt-8 flex-grow">
        <slot />
      </main>

      <footer class="site-footer py-8 mt-16 text-center">
        <nav class="site-nav space-x-6 mb-3">
          <a href="/categories" class="site-nav-link">Categories</a>
          <a href="/about" class="site-nav-link">About</a>
          <a href="/contact" class="site-nav-link">Contact</a>
          <a href="/privacy-policy" class="site-nav-link">Privacy Policy</a>
          <a href="/terms" class="site-nav-link">Terms</a>
        </nav>
        <p class="site-footer-text">
          &copy; {year} Yo Mama Jokes Central. All rights reserved.
        </p>
      </footer>
    </div>

    {/* Custom "Install app" affordance. Prod-only: the service worker that makes
        the site installable (and fires beforeinstallprompt) is itself prod-only. */}
    {import.meta.env.PROD && <InstallPrompt />}

    <script is:inline>
      document.addEventListener("click", function (e) {
        var btn = e.target.closest ? e.target.closest(".copy-link-button") : null;
        if (!btn) return;
        var u = btn.getAttribute("data-copy-url");
        if (navigator.clipboard && u) {
          navigator.clipboard.writeText(u).then(function () {
            btn.classList.add("copied");
            setTimeout(function () {
              btn.classList.remove("copied");
            }, 1200);
          });
        }
      });
    </script>

    {/* Touch-only "scroll glow": light up whichever joke card is crossing the
        vertical middle of the viewport, mirroring the desktop :hover glow (which
        never fires on touch). Only on pointer devices without real hover. The
        effect is a color/shadow glow — no movement — so it runs regardless of
        prefers-reduced-motion. */}
    <script is:inline>
      (function () {
        if (!("IntersectionObserver" in window)) return;
        var touch = window.matchMedia("(hover: none)");
        var observer = null;
        function clearActive() {
          var active = document.querySelectorAll(".joke-card--active");
          for (var i = 0; i < active.length; i++) {
            active[i].classList.remove("joke-card--active");
          }
        }
        function setup() {
          if (observer) {
            observer.disconnect();
            observer = null;
          }
          clearActive();
          if (!touch.matches) return;
          var cards = document.querySelectorAll(".joke-card");
          if (!cards.length) return;
          observer = new IntersectionObserver(
            function (entries) {
              for (var i = 0; i < entries.length; i++) {
                entries[i].target.classList.toggle(
                  "joke-card--active",
                  entries[i].isIntersecting
                );
              }
            },
            // Collapse the root to a thin band across the vertical center, so a
            // card is "active" only while it sits in the middle of the screen.
            { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
          );
          for (var j = 0; j < cards.length; j++) observer.observe(cards[j]);
        }
        setup();
        if (touch.addEventListener) {
          touch.addEventListener("change", function () { setup(); });
        }
      })();
    </script>

    {/* Register the service worker (full-offline PWA). Production only so the
        dev server isn't shadowed by a cached SW. See scripts/pwa.mjs. */}
    {import.meta.env.PROD && (
      <script is:inline>
        if ("serviceWorker" in navigator) {
          window.addEventListener("load", function () {
            navigator.serviceWorker.register("/sw.js");
          });
        }
      </script>
    )}
  </body>
</html>
