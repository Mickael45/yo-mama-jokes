---
import Layout from "@/layouts/Layout.astro";
import { SITE_NAME, CONTACT_EMAIL } from "@/lib/siteConfig";

const title = `Contact | ${SITE_NAME}`;
const description =
  "Get in touch with Yo Mama Jokes Central — joke submissions, corrections, and general questions.";
---

<Layout title={title} description={description} path="/contact">
  <div class="site-page container mx-auto px-4 py-8">
    <div class="site-inner site-prose">
      <h1 class="site-title">Contact Us</h1>
      <p>
        We'd love to hear from you — whether you've got a joke to submit, spotted
        something that needs fixing, or just want to say hello.
      </p>
      <p>
        Email us at{" "}
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. We read every
        message and aim to reply within a few business days.
      </p>
      <p>
        Joke submissions are welcome and are read by a person, not a form. If
        you send one, it helps to say which category you think it belongs in —
        we sort everything into one of 19 themed collections, and a suggestion
        saves us a guess. We do not publish every submission: anything sexual,
        hateful, or built on a slur is rejected, as is anything aimed at a real
        person, and we skip lines already in the collection under slightly
        different wording.
      </p>
      <p>
        Corrections are just as useful as new material. If you spot a typo, a
        broken link, a joke filed under the wrong category, or a duplicate we
        missed, tell us roughly where you saw it and we will fix it. Press and
        partnership enquiries reach the same address.
      </p>
      <p>
        For how we handle your data, see our{" "}
        <a href="/privacy-policy">Privacy Policy</a>.
      </p>
    </div>
  </div>
</Layout>
