---
import Layout from "@/layouts/Layout.astro";
import { SITE_NAME, CONTACT_EMAIL, SITE_URL } from "@/lib/siteConfig";
import { breadcrumbSchema } from "@/lib/jsonld";

const title = `Privacy Policy | ${SITE_NAME}`;
const description =
  "How Yo Mama Jokes Central handles cookies, advertising (Google AdSense), and analytics data.";
const path = "/privacy-policy";

const jsonLd = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Privacy Policy", path },
]);

const effectiveDate = "June 18, 2026";
---

<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <div class="site-page container mx-auto px-4 py-8">
    <div class="site-inner site-prose">
      <h1 class="site-title">Privacy Policy</h1>
      <div>
        <p><em>Last updated: {effectiveDate}</em></p>

        <p>
          This Privacy Policy explains how {SITE_NAME} ({SITE_URL}) ("we", "us")
          collects, uses, and shares information when you visit our website.
        </p>

        <h2 class="site-faq__heading">Information we collect</h2>
        <p>
          We do not ask you to create an account or submit personal
          information. Like most websites, we automatically collect standard log
          and device information (such as your browser type, approximate
          location, and pages visited) through cookies and similar technologies
          used by the third-party services described below.
        </p>

        <h2 class="site-faq__heading">Cookies</h2>
        <p>
          Cookies are small files stored on your device. We and our partners use
          cookies to measure traffic and to serve and personalize advertising.
          You can disable cookies in your browser settings, though some features
          may not work as expected.
        </p>

        <h2 class="site-faq__heading">Advertising &amp; Google AdSense</h2>
        <p>
          We use third-party advertising companies, including Google, to serve
          ads when you visit our site.
        </p>
        <ul>
          <li>
            Third-party vendors, including Google, use cookies to serve ads
            based on a user's prior visits to this website and other websites.
          </li>
          <li>
            Google's use of advertising cookies enables it and its partners to
            serve ads to you based on your visit to this and/or other sites on
            the Internet.
          </li>
          <li>
            You may opt out of personalized advertising by visiting <a
              href="https://www.google.com/settings/ads"
              target="_blank"
              rel="noopener noreferrer">Google Ads Settings</a
            >. You can also opt out of a third-party vendor's use of cookies for
            personalized advertising at <a
              href="https://www.aboutads.info/choices/"
              target="_blank"
              rel="noopener noreferrer">www.aboutads.info</a
            >.
          </li>
        </ul>

        <h2 class="site-faq__heading">Analytics</h2>
        <p>
          We use Google Analytics to understand how visitors use the site. It
          collects information such as pages visited and time on site in an
          aggregated, non-identifying way. See <a
            href="https://policies.google.com/privacy"
            target="_blank"
            rel="noopener noreferrer">Google's Privacy Policy</a
          > for details.
        </p>

        <h2 class="site-faq__heading">Your choices (EEA, UK &amp; California)</h2>
        <p>
          Depending on your location, you may have the right to access, delete,
          or restrict the use of your data, and to object to personalized
          advertising. Visitors in the EEA and UK are shown a consent prompt
          before personalized ads are served. To exercise any of these rights,
          contact us at the address below.
        </p>

        <h2 class="site-faq__heading">Children's privacy</h2>
        <p>
          This site is not directed at children under 13, and we do not
          knowingly collect personal information from them.
        </p>

        <h2 class="site-faq__heading">Changes to this policy</h2>
        <p>
          We may update this Privacy Policy from time to time. Changes will be
          posted on this page with an updated date.
        </p>

        <h2 class="site-faq__heading">Contact</h2>
        <p>
          Questions about this policy? Email us at <a
            href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a
          >.
        </p>
      </div>
    </div>
  </div>
</Layout>
