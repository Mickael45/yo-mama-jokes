---
import Layout from "@/layouts/Layout.astro";
import { SITE_NAME, CONTACT_EMAIL, SITE_URL } from "@/lib/siteConfig";
import { breadcrumbSchema } from "@/lib/jsonld";

const title = `Privacy Policy | ${SITE_NAME}`;
const description =
  "How Yo Mama Jokes Central handles your information. We run no ads, no analytics, and no tracking cookies.";
const path = "/privacy-policy";

const jsonLd = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Privacy Policy", path },
]);

const effectiveDate = "June 18, 2026";
---

<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <div class="site-page container mx-auto px-4 py-8">
    <div class="site-inner site-prose">
      <h1 class="site-title">Privacy Policy</h1>
      <div>
        <p><em>Last updated: {effectiveDate}</em></p>

        <p>
          This Privacy Policy explains how {SITE_NAME} ({SITE_URL}) ("we", "us")
          handles information when you visit our website.
        </p>

        <h2 class="site-faq__heading">Information we collect</h2>
        <p>
          We do not ask you to create an account or submit personal information.
          We run no advertising and no analytics on this site, and we do not use
          cookies or similar technologies to track you. There is no cookie
          banner because there are no tracking cookies to consent to.
        </p>

        <h2 class="site-faq__heading">Server logs</h2>
        <p>
          Like any website, our hosting provider automatically processes
          standard technical request data (such as your IP address and browser
          type) to serve pages and protect the site from abuse. We do not use
          this information to build profiles of visitors or to advertise to you.
        </p>

        <h2 class="site-faq__heading">Local storage</h2>
        <p>
          The site may store a small preference on your device (for example, to
          remember that you dismissed the "Install app" prompt). This stays in
          your browser, is not sent to us, and is not used for tracking. You can
          clear it at any time from your browser settings.
        </p>

        <h2 class="site-faq__heading">Children's privacy</h2>
        <p>
          This site is not directed at children under 13, and we do not
          knowingly collect personal information from them.
        </p>

        <h2 class="site-faq__heading">Changes to this policy</h2>
        <p>
          We may update this Privacy Policy from time to time. Changes will be
          posted on this page with an updated date.
        </p>

        <h2 class="site-faq__heading">Contact</h2>
        <p>
          Questions about this policy? Email us at <a
            href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a
          >.
        </p>
      </div>
    </div>
  </div>
</Layout>
